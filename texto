import org.apache.pdfbox.Loader;
import org.apache.pdfbox.pdmodel.PDDocument;
import org.apache.pdfbox.text.PDFTextStripper;
import java.io.File;
import java.util.*;
import java.util.regex.Pattern;

public class Main {
    public static void main(String[] args) throws Exception {
        Scanner sc = new Scanner(System.in);

        System.out.print("Ruta del PDF: ");
        String ruta = sc.nextLine().trim().replace("\"", "");

        String texto;
        try (PDDocument doc = Loader.loadPDF(new File(ruta))) {
            texto = new PDFTextStripper().getText(doc);
        }

        System.out.print("Tema (palabra a buscar): ");
        String tema = sc.nextLine().trim().toLowerCase();

        String[] frases = texto.replaceAll("\\s+", " ").split("(?<=[.!?]) ");
        List<String> candidatas = new ArrayList<>();
        for (String f : frases) {
            int palabras = f.split(" ").length;
            if (f.toLowerCase().contains(tema) && palabras >= 8 && palabras <= 30) {
                candidatas.add(f);
            }
        }

        if (candidatas.isEmpty()) {
            System.out.println("No encontré frases sobre ese tema.");
            return;
        }

        Collections.shuffle(candidatas);
        int total = Math.min(5, candidatas.size());
        for (int i = 0; i < total; i++) {
            String frase = candidatas.get(i);
            String oculta = "";
            for (String w : frase.split(" ")) {
                String limpia = w.replaceAll("[^\\p{L}]", "");
                if (limpia.length() > oculta.length()) oculta = limpia;
            }
            System.out.println((i + 1) + ". " + frase.replaceFirst(Pattern.quote(oculta), "_____"));
            System.out.println("   Respuesta: " + oculta + "\n");
        }
    }
}
